
/* =========================================
   SIDEBAR BASE
========================================= */

.sidebar {
    width: 254px;
    min-width: 254px;
    height: 100vh;
    height: 100dvh;
    display: flex;
    flex-direction: column;
    background: #111827;
    color: #e5e7eb;
    overflow: hidden;
    box-sizing: border-box;
    border-right: 1px solid rgba(255, 255, 255, 0.06);
    font-family: inherit;
    flex-shrink: 0;
}

/* =========================================
   BRAND
========================================= */

.sidebar-brand {
    flex-shrink: 0;
    padding: 25px 20px 20px;
}

.sidebar-brand-link {
    display: flex;
    align-items: center;
    gap: 10px;
    color: #ffffff;
    text-decoration: none;
    font-size: 23px;
    font-weight: 750;
    letter-spacing: -0.5px;
}

.sidebar-brand-icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    color: #818cf8;
    font-size: 25px;
}

/* =========================================
   NAVIGATION CONTAINER
========================================= */

.sidebar-navigation {
    flex: 1;
    min-height: 0;
    overflow-y: auto;
    overflow-x: hidden;
    padding: 8px 12px 16px;
    scrollbar-width: thin;
    scrollbar-color: #374151 transparent;
}

.sidebar-navigation::-webkit-scrollbar {
    width: 5px;
}

.sidebar-navigation::-webkit-scrollbar-track {
    background: transparent;
}

.sidebar-navigation::-webkit-scrollbar-thumb {
    background: #374151;
    border-radius: 10px;
}

/* =========================================
   SECTION HEADINGS
========================================= */

.sidebar-section-title {
    margin: 18px 8px 10px;
    color: #94a3b8;
    font-size: 11px;
    font-weight: 750;
    letter-spacing: 1.4px;
    line-height: 1.5;
    text-transform: uppercase;
}

.sidebar-settings-heading {
    margin-top: 22px;
    padding-top: 18px;
    border-top: 1px solid #293447;
}

.sidebar-admin-heading {
    margin-top: 22px;
    padding-top: 18px;
    border-top: 1px solid #293447;
}

/* =========================================
   NAVIGATION LINKS
========================================= */

.sidebar-link {
    position: relative;
    display: flex;
    align-items: center;
    gap: 12px;
    width: 100%;
    min-height: 44px;
    margin: 3px 0;
    padding: 10px 12px;
    box-sizing: border-box;

    color: #d1d5db;
    background: transparent;
    border-radius: 9px;
    border: 1px solid transparent;

    font-family: inherit;
    font-size: 15px;
    font-weight: 450;
    line-height: 1.4;
    text-decoration: none;
    cursor: pointer;

    transition:
        background-color 0.18s ease,
        color 0.18s ease,
        border-color 0.18s ease;
}

.sidebar-link:hover {
    color: #ffffff;
    background: #1f2937;
}

.sidebar-link.active {
    color: #ffffff;
    background: #2563eb;
    border-color: rgba(255, 255, 255, 0.06);
}

.sidebar-link-icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
    width: 20px;
    font-size: 18px;
    line-height: 1;
}

.sidebar-link-label {
    flex: 1;
    min-width: 0;
    overflow-wrap: anywhere;
}

/* =========================================
   SETTINGS LINK
========================================= */

.sidebar-settings-heading + .sidebar-link {
    margin-top: 4px;
}

/* =========================================
   SIDEBAR FOOTER
========================================= */

.sidebar-footer {
    display: flex;
    align-items: flex-start;
    gap: 11px;
    flex-shrink: 0;
    margin: 10px 12px 14px;
    padding: 14px 12px;
    background: #1f2937;
    border: 1px solid #293447;
    border-radius: 12px;
}

.sidebar-footer-icon {
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
    width: 30px;
    height: 30px;
    color: #a5b4fc;
    background: #312e81;
    border-radius: 8px;
    font-size: 17px;
}

.sidebar-footer-content {
    min-width: 0;
}

.sidebar-footer-content strong {
    display: block;
    margin: 2px 0 6px;
    color: #ffffff;
    font-size: 13px;
    font-weight: 700;
}

.sidebar-footer-content p {
    margin: 0;
    color: #9ca3af;
    font-size: 11px;
    line-height: 1.6;
}

/* =========================================
   DARK THEME
   Activated by data-theme="dark"
   on the HTML root element.
========================================= */

:root[data-theme="dark"] .sidebar {
    background: #101a2b;
    color: #e2e8f0;
    border-right: 1px solid #263750;
}

:root[data-theme="dark"] .sidebar-brand-link {
    color: #f8fafc;
}

:root[data-theme="dark"] .sidebar-brand-icon {
    color: #818cf8;
}

:root[data-theme="dark"] .sidebar-section-title {
    color: #94a3b8;
}

:root[data-theme="dark"] .sidebar-settings-heading,
:root[data-theme="dark"] .sidebar-admin-heading {
    border-color: #293b54;
}

:root[data-theme="dark"] .sidebar-navigation {
    background: #101a2b;
    scrollbar-color: #475569 transparent;
}

:root[data-theme="dark"] .sidebar-navigation::-webkit-scrollbar-thumb {
    background: #475569;
}

:root[data-theme="dark"] .sidebar-link {
    color: #cbd5e1;
    background: transparent;
    border-color: transparent;
}

:root[data-theme="dark"] .sidebar-link:hover {
    color: #ffffff;
    background: #1e2b40;
}

:root[data-theme="dark"] .sidebar-link.active {
    color: #ffffff;
    background: #2563eb;
    border-color: rgba(255, 255, 255, 0.08);
}

:root[data-theme="dark"] .sidebar-footer {
    background: #1e293b;
    border-color: #334155;
}

:root[data-theme="dark"] .sidebar-footer-content strong {
    color: #f8fafc;
}

:root[data-theme="dark"] .sidebar-footer-content p {
    color: #cbd5e1;
}

/* =========================================
   LIGHT THEME
========================================= */

:root[data-theme="light"] .sidebar {
    background: #ffffff;
    color: #334155;
    border-right: 1px solid #e2e8f0;
}

:root[data-theme="light"] .sidebar-brand-link {
    color: #0f172a;
}

:root[data-theme="light"] .sidebar-section-title {
    color: #64748b;
}

:root[data-theme="light"] .sidebar-settings-heading,
:root[data-theme="light"] .sidebar-admin-heading {
    border-color: #e2e8f0;
}

:root[data-theme="light"] .sidebar-link {
    color: #334155;
}

:root[data-theme="light"] .sidebar-link:hover {
    color: #0f172a;
    background: #f1f5f9;
}

:root[data-theme="light"] .sidebar-link.active {
    color: #ffffff;
    background: #2563eb;
}

:root[data-theme="light"] .sidebar-footer {
    background: #f1f5f9;
    border-color: #e2e8f0;
}

:root[data-theme="light"] .sidebar-footer-content strong {
    color: #0f172a;
}

:root[data-theme="light"] .sidebar-footer-content p {
    color: #64748b;
}

/* =========================================
   ACCESSIBILITY
========================================= */

.sidebar-link:focus-visible,
.sidebar-brand-link:focus-visible {
    outline: 2px solid #60a5fa;
    outline-offset: 3px;
}

/* =========================================
   RESPONSIVE
========================================= */

@media (max-width: 768px) {
    .sidebar {
        width: 230px;
        min-width: 230px;
    }

    .sidebar-brand {
        padding: 20px 16px;
    }

    .sidebar-brand-link {
        font-size: 20px;
    }

    .sidebar-navigation {
        padding-right: 9px;
        padding-left: 9px;
    }

    .sidebar-link {
        min-height: 42px;
        font-size: 14px;
    }

    .sidebar-footer {
        margin-right: 9px;
        margin-left: 9px;
    }
}


/* =====================================================
   AI CAREER OS — RESPONSIVE APPLICATION LAYOUT
   Desktop sidebar + mobile slide-out navigation
===================================================== */

/* Desktop application layout */
.app-layout {
    display: flex;
    width: 100%;
    min-width: 0;
    min-height: 100vh;
    min-height: 100dvh;
}

.app-layout > .sidebar {
    position: fixed;
    inset: 0 auto 0 0;
    z-index: 1100;

    width: 254px;
    min-width: 254px;
    height: 100vh;
    height: 100dvh;

    transform: translateX(0);
    visibility: visible;

    transition:
        transform 0.25s ease,
        background-color 0.2s ease;

    will-change: transform;
}

.app-layout > .app-main {
    flex: 1 1 auto;
    width: calc(100% - 254px);
    min-width: 0;
    max-width: none;

    margin-left: 254px;
    padding: 32px;

    box-sizing: border-box;
    overflow-x: clip;
}

/* Mobile menu controls are hidden on desktop */
.mobile-menu-toggle {
    display: none;
}

.mobile-menu-backdrop {
    display: none;
}

/* Allow page content to shrink inside the layout */
.app-layout > .app-main > * {
    min-width: 0;
    max-width: 100%;
    box-sizing: border-box;
}

/* Prevent large tables and grids from widening the viewport */
.app-main img,
.app-main video,
.app-main canvas,
.app-main iframe {
    max-width: 100%;
}

.app-main table {
    max-width: 100%;
}

/* =====================================================
   TABLETS AND MOBILE
===================================================== */

@media (max-width: 768px) {
    .app-layout {
        display: block;
        width: 100%;
        min-width: 0;
        overflow-x: clip;
    }

    /* Slide-out sidebar drawer */
    .app-layout > .sidebar {
        position: fixed;
        inset: 0 auto 0 0;
        z-index: 1100;

        width: min(300px, 86vw);
        min-width: 0;
        max-width: 86vw;
        height: 100vh;
        height: 100dvh;

        transform: translateX(-105%);
        visibility: hidden;

        overflow: hidden;
        box-shadow: none;

        transition:
            transform 0.25s ease,
            visibility 0.25s ease,
            box-shadow 0.25s ease;
    }

    .app-layout > .sidebar.sidebar-open {
        transform: translateX(0);
        visibility: visible;
        box-shadow: 12px 0 40px rgba(0, 0, 0, 0.18);
    }

    /* Keep the navigation usable on a small screen */
    .sidebar-navigation {
        min-height: 0;
        overflow-x: hidden;
        overflow-y: auto;
        overscroll-behavior: contain;
        padding-bottom: 24px;
    }

    .sidebar-brand {
        padding: 20px 18px;
    }

    .sidebar-brand-link {
        font-size: 21px;
    }

    .sidebar-link {
        min-height: 46px;
        padding: 11px 12px;
        font-size: 14px;
    }

    .sidebar-footer {
        margin-bottom: 12px;
    }

    /* Fixed mobile header button */
    .mobile-menu-toggle {
        position: fixed;
        top: 12px;
        left: 12px;
        z-index: 1200;

        display: inline-flex;
        align-items: center;
        justify-content: flex-start;
        gap: 11px;

        min-height: 46px;
        max-width: calc(100vw - 24px);
        padding: 0 15px;

        color: var(--text-primary, #0f172a);
        background: var(--surface-bg, #ffffff);

        border: 1px solid var(--border-color, #e2e8f0);
        border-radius: 13px;

        box-shadow: 0 4px 18px rgba(15, 23, 42, 0.09);

        font-family: inherit;
        font-size: 14px;
        font-weight: 700;

        cursor: pointer;
        -webkit-tap-highlight-color: transparent;
    }

    .mobile-menu-toggle:focus-visible {
        outline: 3px solid #60a5fa;
        outline-offset: 3px;
    }

    .mobile-menu-toggle-icon {
        display: inline-flex;
        align-items: center;
        justify-content: center;

        width: 22px;
        min-width: 22px;

        font-size: 22px;
        line-height: 1;
    }

    .mobile-menu-toggle-label {
        overflow: hidden;
        text-overflow: ellipsis;
        white-space: nowrap;
    }

    /* Dark translucent backdrop */
    .mobile-menu-backdrop {
        position: fixed;
        inset: 0;
        z-index: 1050;

        display: block;
        width: 100%;
        height: 100%;
        padding: 0;
        margin: 0;

        background: rgba(5, 12, 25, 0.55);
        border: 0;
        border-radius: 0;

        cursor: pointer;
        -webkit-tap-highlight-color: transparent;
        animation: career-backdrop-in 0.2s ease;
    }

    /* Main page fills the phone screen */
    .app-layout > .app-main {
        display: block;

        width: 100%;
        max-width: 100%;
        min-width: 0;
        min-height: 100vh;
        min-height: 100dvh;

        margin-left: 0;
        padding: 76px 20px 28px;

        box-sizing: border-box;
        overflow-x: clip;
    }

    .app-layout > .app-main > * {
        width: 100%;
        min-width: 0;
        max-width: 100%;
    }

    /* Keep common grids responsive */
    .app-main [class*="grid"] {
        min-width: 0;
        max-width: 100%;
    }

    .app-main input,
    .app-main textarea,
    .app-main select {
        max-width: 100%;
        box-sizing: border-box;
    }
}

/* Smaller phones */
@media (max-width: 480px) {
    .mobile-menu-toggle {
        top: 10px;
        left: 10px;
        min-height: 44px;
        padding: 0 12px;
    }

    .app-layout > .app-main {
        padding: 68px 12px 22px;
    }

    .sidebar-brand {
        padding: 18px 16px;
    }

    .sidebar-footer {
        margin-right: 9px;
        margin-left: 9px;
    }
}

/* Respect reduced-motion preferences */
@keyframes career-backdrop-in {
    from {
        opacity: 0;
    }

    to {
        opacity: 1;
    }
}

@media (prefers-reduced-motion: reduce) {
    .app-layout > .sidebar,
    .mobile-menu-backdrop,
    .mobile-menu-toggle {
        animation: none;
        transition: none;
    }
}
