# Examples intentionally have no credentials or deployment hostnames.
NODE_ENV=development
PORT=5000
MONGO_URI=
JWT_SECRET=
# Required in production: comma-separated exact HTTPS frontend origins, no paths/wildcards.
CORS_ORIGINS=
MAIL_HOST=
MAIL_PORT=
MAIL_SECURE=
MAIL_USER=
MAIL_PASS=
MAIL_FROM=
# Optional integrations, required only for the corresponding features:
OPENAI_API_KEY=
GROQ_API_KEY=
GROQ_MODEL=
GITHUB_TOKEN=
# Email delivery requires all six MAIL_* values above in every environment.
# MAIL_FROM: bare provider-authorized mailbox address, no display name or angle brackets.
# MAIL_SECURE=true: implicit TLS (commonly port 465).
# MAIL_SECURE=false: STARTTLS required (commonly port 587); follow provider settings.
# Use the provider's SMTP credential and verify its sender/domain authorization.
# Never place SMTP credentials in client VITE_* variables. See docs/password-recovery-email.md.

# Interview evaluation: production defaults to Groq; development defaults to Ollama.
# Set explicitly to groq or ollama. Hosted mode requires GROQ_API_KEY and a model
# in INTERVIEW_AI_MODEL (or the existing GROQ_MODEL); no model is assumed available.
INTERVIEW_AI_PROVIDER=
INTERVIEW_AI_MODEL=
# Optional milliseconds, integer 1000..120000. Defaults: Groq 45000, Ollama 90000.
INTERVIEW_AI_TIMEOUT_MS=
# Ollama mode only: development defaults to loopback /api/generate and qwen3:4b.
# Production requires an explicit remote HTTPS /api/generate endpoint.
OLLAMA_URL=
OLLAMA_MODEL=
OLLAMA_TIMEOUT_MS=
# Optional bearer credential for an authenticated remote Ollama endpoint.
OLLAMA_API_KEY=
