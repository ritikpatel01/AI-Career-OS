# Examples intentionally have no credentials or deployment hostnames.
NODE_ENV=development
PORT=5000
MONGO_URI=
JWT_SECRET=
# Required in production: comma-separated exact HTTPS frontend origins, no paths/wildcards.
CORS_ORIGINS=
MAIL_HOST=
MAIL_PORT=
MAIL_SECURE=
MAIL_USER=
MAIL_PASS=
MAIL_FROM=
# Optional integrations, required only for the corresponding features:
OPENAI_API_KEY=
GROQ_API_KEY=
GROQ_MODEL=
GITHUB_TOKEN=
